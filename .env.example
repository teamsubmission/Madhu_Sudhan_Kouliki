# Environment configuration template for the Policy Overview BFF.
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is auto-loaded by Docker Compose and is git-ignored. To make these values
# visible to a locally run Spring Boot app (not via Compose), export them into your
# shell, e.g.:  set -a && source .env && set +a
#
# All values below match the application's built-in local defaults, so copying this
# file as-is keeps local development working with no changes.

# --- PostgreSQL container (consumed by docker-compose.yml) ---
DB_NAME=policydb
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# --- Spring Boot datasource (consumed by application.yml) ---
# Must point at the database above; the host port matches DB_PORT.
DB_URL=jdbc:postgresql://localhost:5432/policydb
